datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model UserProfile {
  id             String   @id @default(uuid())
  display_name   String   @default("User")
  gender         String   @default("Not specified")
  persona        String   @db.Text
  response_style String   @db.Text
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
  @@map("userprofile")
}

model Character {
  id                  String        @id @default(uuid())
  name                String
  avatar_url          String?
  gender              String        @default("Not specified")
  persona             String        @db.Text
  greeting            String        @db.Text
  backstory           String        @db.Text
  key_memories        String        @db.Text
  scenario            String        @db.Text
  response_directives String        @db.Text
  example_dialogue    String        @db.Text
  created_at          DateTime      @default(now())
  updated_at          DateTime      @updatedAt
  sessions            ChatSession[]
  @@map("character")
}

model ChatSession {
  id                String        @id @default(uuid())
  character_id      String
  title             String
  global_summary    String?       @db.Text
  current_state     String?       @db.Text
  msg_since_summary Int           @default(0)
  created_at        DateTime      @default(now())
  updated_at        DateTime      @updatedAt
  character         Character     @relation(fields: [character_id], references: [id], onDelete: Cascade)
  messages          ChatMessage[]
  @@map("chatsession")
}

model ChatMessage {
  id              String      @id @default(uuid())
  chat_session_id String
  sender          String
  content         String      @db.Text
  created_at      DateTime    @default(now())
  session         ChatSession @relation(fields: [chat_session_id], references: [id], onDelete: Cascade)
  @@map("chatmessage")
}

model UserFact {
  id           String   @id @default(uuid())
  user_id      String
  character_id String
  subject      String
  predicate    String
  object       String   @db.Text
  raw_fact     String   @db.Text
  embedding    Unsupported("vector(1024)")?
  created_at   DateTime @default(now())
  @@map("user_facts")
}
